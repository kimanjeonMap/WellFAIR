<%--
  공통 <head>. include 하기 전에 pageTitle 을 정한다 : <c:set var="pageTitle" value="로그인"/>
  화면별 css 가 있으면 pageCss 에 파일명만 : <c:set var="pageCss" value="login"/>
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="ctx" content="${pageContext.request.contextPath}/">
  <title><c:out value="${pageTitle}"/> | WellFAIR</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
  <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css">
  <c:if test="${not empty pageCss}">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/${pageCss}.css">
  </c:if>
  <c:if test="${not empty pageCss2}">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/${pageCss2}.css">
  </c:if>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
